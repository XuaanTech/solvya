---
import { SITE } from '../data/site';

interface Props {
  slot?: 'home' | 'tool' | 'articleTop' | 'articleMid' | 'articleBottom';
  className?: string;
}
const { slot = 'tool', className = '' } = Astro.props;
const slotId = SITE.adSlots[slot] || SITE.adSlots.tool;
---
<div class={`ad-slot ${className}`} aria-hidden="false">
  <p class="ad-slot__label">Publicidad / Advertisement</p>
  <ins
    class="adsbygoogle ad-slot__ins"
    style="display:block"
    data-ad-client={SITE.adsClient}
    data-ad-slot={slotId}
    data-ad-format="auto"
    data-full-width-responsive="true"
  ></ins>
  <script is:inline>
    (adsbygoogle = window.adsbygoogle || []).push({});
  </script>
  <noscript>
    <p>JavaScript desactivado.</p>
  </noscript>
</div>