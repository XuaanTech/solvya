---
import { langBase, pick } from '../lib/utils';

interface Props {
  cat: {
    slug: string;
    icon: string;
    name: { es: string; en: string };
    desc: { es: string; en: string };
  };
  lang?: string;
}

const { cat, lang = 'es' } = Astro.props;
---
<a href={`${langBase(lang)}/${cat.slug}/`} class="category-card" data-astro-prefetch="hover">
  <span class="category-card__icon" aria-hidden="true">{cat.icon}</span>
  <div class="category-card__info">
    <h3 class="category-card__title">{pick(cat.name, lang)}</h3>
    <p class="category-card__desc">{pick(cat.desc, lang)}</p>
  </div>
  <span class="category-card__arrow" aria-hidden="true">›</span>
</a>