---
import { SITE } from '../data/site';

interface Props {
  lang?: string;
}
const { lang = 'es' } = Astro.props;
const privacyPath = lang === 'en' ? '/en/privacy-policy/' : '/privacy-policy/';
---

<!-- Cookie Consent Banner -->
<div id="cc-banner" class="cc-banner" role="dialog" aria-label="Cookie consent" style="display:none">
  <div class="container cc-banner__inner">
    <div class="cc-banner__content">
      <h2 class="cc-banner__title" data-i18n="cookie.title">🍪 Cookies y privacidad</h2>
      <p class="cc-banner__desc" data-i18n="cookie.desc">
        Usamos cookies para contenido, análisis y publicidad. Puedes aceptar todas, rechazarlas o personalizar tu elección.
      </p>
      <p class="cc-banner__desc cc-banner__desc--policy">
        <span data-i18n="cookie.policy">Consulta nuestra</span>
        <a href={privacyPath} data-i18n="cookie.policyLink">política de privacidad</a>.
      </p>
    </div>
    <div class="cc-banner__actions">
      <button class="btn btn--ghost btn--sm" id="cc-reject" data-i18n="cookie.rejectAll">Rechazar todas</button>
      <button class="btn btn--ghost btn--sm" id="cc-customize" data-i18n="cookie.customizeTitle">Personalizar</button>
      <button class="btn btn--primary btn--sm" id="cc-accept" data-i18n="cookie.acceptAll">Aceptar todas</button>
    </div>
  </div>
</div>

<!-- Cookie Consent Modal -->
<div id="cc-modal" class="cc-modal" role="dialog" aria-label="Cookie preferences" style="display:none">
  <div class="cc-modal__backdrop" id="cc-modal-backdrop"></div>
  <div class="cc-modal__content">
    <div class="cc-modal__header">
      <h2 class="cc-modal__title" data-i18n="cookie.title">🍪 Cookies y privacidad</h2>
      <button class="cc-modal__close" id="cc-modal-close" aria-label="Close">&times;</button>
    </div>
    <div class="cc-modal__body">
      <p class="cc-modal__desc" data-i18n="cookie.desc">
        Usamos cookies para contenido, análisis y publicidad. Puedes aceptar todas, rechazarlas o personalizar tu elección.
      </p>

      <!-- Required cookies -->
      <div class="cc-toggle">
        <div class="cc-toggle__info">
          <span class="cc-toggle__name" data-i18n="cookie.required">Las cookies necesarias son esenciales para el funcionamiento del sitio.</span>
          <span class="cc-toggle__tag" data-i18n="cookie.requiredTag">Necesarias</span>
        </div>
      </div>

      <!-- Analytics cookies -->
      <div class="cc-toggle">
        <div class="cc-toggle__info">
          <span class="cc-toggle__name" data-i18n="cookie.analytics">Cookies de análisis (Google Analytics)</span>
          <span class="cc-toggle__desc" data-i18n="cookie.analyticsDesc">Nos ayudan a entender cómo usas la web para mejorarla.</span>
        </div>
        <label class="cc-toggle__switch">
          <input type="checkbox" id="cc-analytics" checked />
          <span class="cc-toggle__slider"></span>
        </label>
      </div>

      <!-- Ads cookies -->
      <div class="cc-toggle">
        <div class="cc-toggle__info">
          <span class="cc-toggle__name" data-i18n="cookie.ads">Cookies de publicidad (Google AdSense)</span>
          <span class="cc-toggle__desc" data-i18n="cookie.adsDesc">Permiten mostrar anuncios relevantes y medir su efectividad.</span>
        </div>
        <label class="cc-toggle__switch">
          <input type="checkbox" id="cc-ads" checked />
          <span class="cc-toggle__slider"></span>
        </label>
      </div>

      <p class="cc-modal__policy">
        <span data-i18n="cookie.policy">Consulta nuestra</span>
        <a href={privacyPath} data-i18n="cookie.policyLink">política de privacidad</a>.
      </p>
    </div>
    <div class="cc-modal__footer">
      <button class="btn btn--ghost btn--sm" id="cc-modal-reject" data-i18n="cookie.rejectAll">Rechazar todas</button>
      <button class="btn btn--primary btn--sm" id="cc-modal-save" data-i18n="cookie.savePrefs">Guardar preferencias</button>
    </div>
  </div>
</div>

<script is:inline define:vars={{ SITE }}>
(function () {
  var CONSENT_KEY = 'solvya-cookie-consent';
  var GA_ID = SITE.analyticsId;

  /* ── Consent helpers ─────────────────────────────── */
  function getConsent() {
    try { return JSON.parse(localStorage.getItem(CONSENT_KEY)); } catch { return null; }
  }
  /** True if the visitor has already made a decision (accept or reject). */
  function hasDecision() {
    var c = getConsent();
    return c !== null && typeof c === 'object';
  }
  /** True if any tracking was granted. */
  function hasConsent() {
    var c = getConsent();
    return !!c && (c.analytics || c.ads);
  }

  /* ── Google Analytics loader ─────────────────────── */
  function loadGA() {
    if (document.getElementById('cc-ga-script')) return;
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    window.gtag = gtag;
    gtag('js', new Date());
    gtag('config', GA_ID, { anonymize_ip: true });
    var s = document.createElement('script');
    s.id = 'cc-ga-script';
    s.async = true;
    s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
    document.head.appendChild(s);
  }

  /* ── AdSense loader ──────────────────────────────── */
  function loadAdSense() {
    if (document.querySelector('script[src*="pagead2.googlesyndication.com"]')) return;
    var s = document.createElement('script');
    s.async = true;
    s.crossOrigin = 'anonymous';
    s.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=' + SITE.adsClient;
    document.head.appendChild(s);
  }

  /* ── Reload ads already on page ──────────────────── */
  function reloadAds() {
    if (typeof window.adsbygoogle !== 'undefined') {
      document.querySelectorAll('.ad-slot ins.adsbygoogle').forEach(function (ins) {
        if (!ins.dataset.ccLoaded) {
          try { (window.adsbygoogle = window.adsbygoogle || []).push({}); } catch {}
          ins.dataset.ccLoaded = '1';
        }
      });
    }
  }

  /* ── Apply consent (accept or saved prefs) ───────── */
  function applyConsent(consent) {
    try { localStorage.setItem(CONSENT_KEY, JSON.stringify(consent)); } catch {}
    if (consent.analytics) loadGA();
    if (consent.ads) { loadAdSense(); reloadAds(); }
    window.dispatchEvent(new CustomEvent('cookie-consent-change', { detail: consent }));
  }

  /* ── Remove tracking on reject / revoke ──────────── */
  function removeTracking() {
    // Persist the decision so the banner does not reappear on every visit
    try { localStorage.setItem(CONSENT_KEY, JSON.stringify({ analytics: false, ads: false })); } catch {}

    // Remove GA script
    var gaScript = document.getElementById('cc-ga-script');
    if (gaScript) gaScript.remove();

    // Remove GA cookies
    document.cookie.split(';').forEach(function (c) {
      var name = c.split('=')[0].trim();
      if (name.startsWith('_ga') || name.startsWith('_gid') || name.startsWith('_gat')) {
        document.cookie = name + '=;expires=Thu, 01 Jan 1970 00:00:00 GMT;path=/;domain=' + window.location.hostname;
        document.cookie = name + '=;expires=Thu, 01 Jan 1970 00:00:00 GMT;path=/';
      }
    });

    // Remove AdSense
    var adScript = document.querySelector('script[src*="pagead2.googlesyndication.com"]');
    if (adScript) adScript.remove();

    // Clean up gtag
    window.gtag = undefined;
    window.dataLayer = undefined;

    window.dispatchEvent(new CustomEvent('cookie-consent-change', { detail: { analytics: false, ads: false } }));
  }

  /* ── Show/hide banner ────────────────────────────── */
  function showBanner() {
    var b = document.getElementById('cc-banner');
    if (b) { b.style.display = ''; b.classList.remove('cc-banner--hide'); }
  }
  function hideBanner() {
    var b = document.getElementById('cc-banner');
    if (b) { b.classList.add('cc-banner--hide'); setTimeout(function () { b.style.display = 'none'; }, 300); }
  }

  /* ── Modal ───────────────────────────────────────── */
  function openModal() {
    var m = document.getElementById('cc-modal');
    if (!m) return;
    var c = getConsent();
    var a = document.getElementById('cc-analytics');
    var d = document.getElementById('cc-ads');
    if (a) a.checked = c ? c.analytics : false;
    if (d) d.checked = c ? c.ads : false;
    m.style.display = '';
    document.body.style.overflow = 'hidden';
  }
  function closeModal() {
    var m = document.getElementById('cc-modal');
    if (m) { m.style.display = 'none'; document.body.style.overflow = ''; }
  }

  /* ── Events ──────────────────────────────────────── */
  document.getElementById('cc-accept')?.addEventListener('click', function () {
    applyConsent({ analytics: true, ads: true }); hideBanner();
  });
  document.getElementById('cc-reject')?.addEventListener('click', function () {
    removeTracking(); hideBanner();
  });
  document.getElementById('cc-customize')?.addEventListener('click', function () { openModal(); });
  document.getElementById('cc-modal-close')?.addEventListener('click', closeModal);
  document.getElementById('cc-modal-backdrop')?.addEventListener('click', closeModal);
  document.getElementById('cc-modal-reject')?.addEventListener('click', function () {
    removeTracking(); closeModal(); hideBanner();
  });
  document.getElementById('cc-modal-save')?.addEventListener('click', function () {
    var a = document.getElementById('cc-analytics');
    var d = document.getElementById('cc-ads');
    var consent = { analytics: a ? a.checked : false, ads: d ? d.checked : false };
    // If everything was unchecked, treat as a rejection (disables tracking, persists decision)
    if (!consent.analytics && !consent.ads) removeTracking();
    else applyConsent(consent);
    closeModal(); hideBanner();
  });

  /* ── Reopen preferences (footer link) ────────────── */
  window.openCookieSettings = openModal;

  /* ── Init: check existing consent ────────────────── */
  document.addEventListener('DOMContentLoaded', function () {
    if (hasDecision()) {
      // Apply previously granted consent (rejections apply nothing)
      if (hasConsent()) applyConsent(getConsent());
    } else {
      // First visit: nothing is loaded until the visitor decides
      setTimeout(showBanner, 1000);
    }
  });
})();
</script>

<style>
/* ═══════════════════════════════════════════════════════════════
   Cookie Consent Banner & Modal
   ═══════════════════════════════════════════════════════════════ */

/* ── Banner ──────────────────────────────────────────────────── */
.cc-banner {
  position: fixed; bottom: 0; left: 0; right: 0;
  background: var(--bg-card); border-top: 1px solid var(--border);
  box-shadow: 0 -4px 20px rgba(0,0,0,.12);
  z-index: 1000; padding: 1rem 0;
  animation: cc-slide-up .3s ease-out;
}
.cc-banner--hide {
  animation: cc-slide-down .3s ease-in forwards;
}
@keyframes cc-slide-up {
  from { transform: translateY(100%); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}
@keyframes cc-slide-down {
  from { transform: translateY(0); opacity: 1; }
  to { transform: translateY(100%); opacity: 0; }
}
.cc-banner__inner {
  display: flex; align-items: center; justify-content: space-between;
  gap: 1.5rem; flex-wrap: wrap;
}
.cc-banner__content { flex: 1; min-width: 280px; }
.cc-banner__title {
  font-size: 1rem; font-weight: 700; margin-bottom: 0.3rem; color: var(--text);
}
.cc-banner__desc {
  font-size: 0.85rem; color: var(--text-muted); line-height: 1.5; margin: 0;
}
.cc-banner__desc--policy { margin-top: 0.35rem; }
.cc-banner__desc--policy a { color: var(--primary); text-decoration: underline; }
.cc-banner__actions {
  display: flex; gap: 0.5rem; flex-shrink: 0; flex-wrap: wrap;
}
@media (max-width: 640px) {
  .cc-banner__inner { flex-direction: column; align-items: stretch; }
  .cc-banner__actions { justify-content: stretch; }
  .cc-banner__actions .btn { flex: 1; justify-content: center; }
}

/* ── Modal ───────────────────────────────────────────────────── */
.cc-modal {
  position: fixed; inset: 0; z-index: 2000;
  display: flex; align-items: center; justify-content: center;
  padding: 1rem;
}
.cc-modal__backdrop {
  position: absolute; inset: 0;
  background: rgba(0,0,0,.5); backdrop-filter: blur(2px);
}
.cc-modal__content {
  position: relative; width: 100%; max-width: 520px; max-height: 85vh;
  background: var(--bg-card); border: 1px solid var(--border);
  border-radius: var(--radius-lg); box-shadow: 0 20px 60px rgba(0,0,0,.2);
  display: flex; flex-direction: column; overflow: hidden;
  animation: cc-modal-in .2s ease-out;
}
@keyframes cc-modal-in {
  from { transform: scale(.95); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}
.cc-modal__header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 1rem 1.25rem; border-bottom: 1px solid var(--border);
}
.cc-modal__title { font-size: 1.1rem; font-weight: 700; margin: 0; color: var(--text); }
.cc-modal__close {
  background: none; border: none; font-size: 1.5rem; color: var(--text-muted);
  padding: 0.25rem; line-height: 1; cursor: pointer;
}
.cc-modal__close:hover { color: var(--text); }
.cc-modal__body {
  padding: 1.25rem; overflow-y: auto; flex: 1;
}
.cc-modal__desc { font-size: 0.9rem; color: var(--text-muted); line-height: 1.5; margin-bottom: 1.25rem; }
.cc-modal__policy { font-size: 0.85rem; color: var(--text-muted); margin-top: 1.25rem; }
.cc-modal__policy a { color: var(--primary); text-decoration: underline; }
.cc-modal__footer {
  display: flex; justify-content: flex-end; gap: 0.5rem;
  padding: 1rem 1.25rem; border-top: 1px solid var(--border);
}

/* ── Toggle rows ─────────────────────────────────────────────── */
.cc-toggle {
  display: flex; align-items: center; justify-content: space-between;
  padding: 0.85rem 1rem; margin-bottom: 0.5rem;
  border: 1px solid var(--border); border-radius: var(--radius);
  background: var(--bg-alt);
}
.cc-toggle__info { flex: 1; padding-right: 1rem; }
.cc-toggle__name {
  font-size: 0.9rem; font-weight: 600; color: var(--text); display: block;
}
.cc-toggle__desc {
  font-size: 0.8rem; color: var(--text-muted); margin-top: 0.15rem; display: block;
}
.cc-toggle__tag {
  display: inline-block; font-size: 0.7rem; font-weight: 700; text-transform: uppercase;
  background: var(--primary); color: var(--text-inverse);
  padding: 0.1rem 0.5rem; border-radius: 999px; margin-top: 0.25rem;
}

/* ── Toggle switch ───────────────────────────────────────────── */
.cc-toggle__switch {
  position: relative; display: inline-block;
  width: 2.75rem; height: 1.5rem; flex-shrink: 0;
}
.cc-toggle__switch input { opacity: 0; width: 0; height: 0; position: absolute; }
.cc-toggle__slider {
  position: absolute; inset: 0; cursor: pointer;
  background: var(--border); border-radius: 999px;
  transition: background .2s;
}
.cc-toggle__slider::before {
  content: ''; position: absolute; left: 2px; bottom: 2px;
  width: 1.1rem; height: 1.1rem; border-radius: 50%;
  background: var(--bg-card); box-shadow: 0 1px 3px rgba(0,0,0,.2);
  transition: transform .2s;
}
.cc-toggle__switch input:checked + .cc-toggle__slider { background: var(--primary); }
.cc-toggle__switch input:checked + .cc-toggle__slider::before { transform: translateX(1.25rem); }
.cc-toggle__switch input:focus-visible + .cc-toggle__slider {
  box-shadow: 0 0 0 3px rgba(5,150,105,.4);
}
</style>
