---
import { langText } from '../lib/i18n';
import { langBase } from '../lib/utils';

interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
const base = langBase(lang);
---
<form class="search-bar" action={`${base}/search/`} method="get" role="search">
  <svg class="search-bar__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <circle cx="11" cy="11" r="8" />
    <path d="m21 21-4.3-4.3" />
  </svg>
  <input
    class="search-bar__input"
    type="search"
    name="q"
    data-i18n-placeholder="search.placeholder"
    placeholder={langText(lang, 'search.placeholder')}
    autocomplete="off"
    minlength="2"
    aria-label={langText(lang, 'search.placeholder')}
  />
  <button class="search-bar__submit" data-i18n="nav.search" type="submit">{langText(lang, 'nav.search')}</button>
</form>