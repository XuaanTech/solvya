---
import { langText } from '../../lib/i18n';
const es = 'es';
---
<div class="tool-widget" data-widget="frecuencia-cardiaca">
  <form class="tool-widget__form" data-calc-form novalidate>
    <div class="tool-widget__grid tool-widget__grid--2">
      <div class="tool-widget__field">
        <label class="tool-widget__label" for="fc-edad" data-i18n="calc.age">{langText(es, 'calc.age')}</label>
        <div class="tool-widget__control">
          <span class="tool-widget__adorn tool-widget__adorn--left">años</span>
          <input id="fc-edad" class="tool-widget__input" type="text" inputmode="numeric" autocomplete="off" value="35" data-field="edad" />
        </div>
      </div>
      <div class="tool-widget__field">
        <label class="tool-widget__label" for="fc-reposo" data-i18n="calc.restingHR">{langText(es, 'calc.restingHR')}</label>
        <div class="tool-widget__control">
          <span class="tool-widget__adorn tool-widget__adorn--left">lpm</span>
          <input id="fc-reposo" class="tool-widget__input" type="text" inputmode="numeric" autocomplete="off" placeholder="—" data-field="reposo" />
        </div>
      </div>
    </div>
    <div class="tool-widget__actions">
      <button type="submit" class="btn btn--primary" data-i18n="calc.calculate">{langText(es, 'calc.calculate')}</button>
      <button type="button" class="btn btn--ghost" data-reset data-i18n="calc.reset">{langText(es, 'calc.reset')}</button>
    </div>
  </form>

  <div class="tool-widget__result" data-result hidden>
    <p class="tool-widget__error" data-error hidden data-i18n="calc.invalid">
      <span data-lang-region="es">{langText(es, 'calc.invalid')}</span>
      <span data-lang-region="en" hidden>{langText('en', 'calc.invalid')}</span>
    </p>
    <div class="result-stats">
      <div class="result-stat">
        <span class="result-stat__label" data-i18n="calc.maxHR">{langText(es, 'calc.maxHR')}</span>
        <strong class="result-stat__value" data-val="fcMaxima">—</strong>
        <span class="result-stat__unit" data-i18n="calc.bpm">{langText(es, 'calc.bpm')}</span>
      </div>
      <div class="result-stat">
        <span class="result-stat__label" data-i18n="calc.metodo">{langText(es, 'calc.metodo')}</span>
        <strong class="result-stat__value">
          <span data-val="metodo-es" data-lang-region="es"></span>
          <span data-val="metodo-en" data-lang-region="en" hidden></span>
        </strong>
      </div>
    </div>
    <ul class="tool-widget__zones" data-zones></ul>
    <p class="tool-widget__note">
      <span data-lang-region="es" data-i18n="calc.karvonenNote">{langText(es, 'calc.karvonenNote')}</span>
      <span data-lang-region="en" hidden data-i18n="calc.karvonenNote">{langText('en', 'calc.karvonenNote')}</span>
    </p>
  </div>
</div>

<script>
  import { zonasCardiacas, fcMaxima } from '../../lib/health-calc.js';
  import { parseDecimal } from '../../lib/format.js';
  import { textOf, applyLang, currentLang } from '../../i18n.js';

  const root = document.querySelector('[data-widget="frecuencia-cardiaca"]');
  if (root) {
    const form = root.querySelector('[data-calc-form]');
    const result = root.querySelector('[data-result]');
    const error = root.querySelector('[data-error]');
    const zonesList = root.querySelector('[data-zones]');
    const fields = {
      edad: root.querySelector('[data-field="edad"]'),
      reposo: root.querySelector('[data-field="reposo"]'),
    };
    const val = {
      fcMaxima: root.querySelector('[data-val="fcMaxima"]'),
      metodoEs: root.querySelector('[data-val="metodo-es"]'),
      metodoEn: root.querySelector('[data-val="metodo-en"]'),
    };
    const ZONE_PCT = [
      { min: 50, max: 60 }, { min: 60, max: 70 }, { min: 70, max: 80 },
      { min: 80, max: 90 }, { min: 90, max: 100 },
    ];

    function renderZones(zones, reposo) {
      zonesList.innerHTML = '';
      const lang = currentLang();
      zones.forEach((z, i) => {
        const li = document.createElement('li');
        li.className = 'tool-widget__zone';
        const name = textOf(lang, 'calc.' + z.key) || z.key;
        const head = document.createElement('strong');
        head.textContent = name;
        const range = document.createElement('span');
        const pct = textOf(lang, 'calc.intensity') + ' ' + ZONE_PCT[i].min + '–' + ZONE_PCT[i].max + ' %';
        range.textContent = z.min + '–' + z.max + ' ' + textOf(lang, 'calc.bpm') + ' · ' + pct;
        li.append(head, range);
        zonesList.appendChild(li);
      });
    }

    function compute() {
      const edad = parseDecimal(fields.edad.value);
      const reposo = parseDecimal(fields.reposo.value);
      if (!Number.isFinite(edad) || edad <= 0) { error.hidden = false; result.hidden = true; return; }
      const max = fcMaxima(edad);
      const zones = zonasCardiacas({ edad, reposoFC: reposo || 0 });
      if (!zones) { error.hidden = false; result.hidden = true; return; }
      error.hidden = true;
      val.fcMaxima.textContent = max;
      const lang = currentLang();
      const useKarvonen = Number.isFinite(reposo) && reposo > 0;
      val.metodoEs.textContent = textOf('es', useKarvonen ? 'calc.karvonen' : 'calc.porcentajeMax');
      val.metodoEn.textContent = textOf('en', useKarvonen ? 'calc.karvonen' : 'calc.porcentajeMax');
      applyLang(lang);
      renderZones(zones, reposo);
      result.hidden = false;
    }

    form?.addEventListener('submit', (e) => { e.preventDefault(); compute(); });
    fields.edad.addEventListener('input', compute);
    fields.reposo.addEventListener('input', compute);
    root.querySelector('[data-reset]')?.addEventListener('click', () => {
      for (const f of Object.values(fields)) f.value = f.defaultValue;
      result.hidden = true; error.hidden = true;
    });
    compute();
  }
</script>