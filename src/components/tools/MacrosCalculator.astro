---
import { langText } from '../../lib/i18n';
const es = 'es';
const ACTIVITY_LEVELS = [
  { value: 1.2, key: 'sedentary', label: { es: 'Sedentario (poco o ningún ejercicio)', en: 'Sedentary (little or no exercise)' } },
  { value: 1.375, key: 'light', label: { es: 'Ligero (ejercicio 1-3 días/semana)', en: 'Light (exercise 1-3 days/week)' } },
  { value: 1.55, key: 'moderate', label: { es: 'Moderado (ejercicio 3-5 días/semana)', en: 'Moderate (exercise 3-5 days/week)' } },
  { value: 1.725, key: 'active', label: { es: 'Activo (ejercicio 6-7 días/semana)', en: 'Active (exercise 6-7 days/week)' } },
  { value: 1.9, key: 'very_active', label: { es: 'Muy activo (entrenamiento 2x/día, trabajo físico)', en: 'Very active (2x/day training, physical job)' } },
];
const GOALS = [
  { value: 'maintain', label: { es: 'Mantener peso', en: 'Maintain weight' }, adj: 0 },
  { value: 'mild_loss', label: { es: 'Perder peso suave (-0.25 kg/sem)', en: 'Mild weight loss (-0.25 kg/week)' }, adj: -250 },
  { value: 'loss', label: { es: 'Perder peso (-0.5 kg/sem)', en: 'Weight loss (-0.5 kg/week)' }, adj: -500 },
  { value: 'aggressive_loss', label: { es: 'Perder peso rápido (-1 kg/sem)', en: 'Aggressive loss (-1 kg/week)' }, adj: -1000 },
  { value: 'mild_gain', label: { es: 'Ganar peso suave (+0.25 kg/sem)', en: 'Mild weight gain (+0.25 kg/week)' }, adj: 250 },
  { value: 'gain', label: { es: 'Ganar peso (+0.5 kg/sem)', en: 'Weight gain (+0.5 kg/week)' }, adj: 500 },
];
const PRESETS = [
  { key: 'balanced', label: { es: 'Equilibrado (40/30/30)', en: 'Balanced (40/30/30)' }, carbs: 40, protein: 30, fat: 30 },
  { key: 'high_protein', label: { es: 'Alto en proteína (40/40/20)', en: 'High protein (40/40/20)' }, carbs: 40, protein: 40, fat: 20 },
  { key: 'low_carb', label: { es: 'Bajo en carbohidratos (20/40/40)', en: 'Low carb (20/40/40)' }, carbs: 20, protein: 40, fat: 40 },
  { key: 'keto', label: { es: 'Keto (5/25/70)', en: 'Keto (5/25/70)' }, carbs: 5, protein: 25, fat: 70 },
  { key: 'zone', label: { es: 'Zona (40/30/30)', en: 'Zone (40/30/30)' }, carbs: 40, protein: 30, fat: 30 },
];
---
<div class="tool-widget" data-widget="macros">
  <form class="tool-widget__form" data-calc-form novalidate>
    <div class="tool-widget__grid tool-widget__grid--2">
      <div class="tool-widget__field">
        <label class="tool-widget__label" for="mc-sex" data-i18n="calc.mcSex">{langText(es, 'calc.mcSex')}</label>
        <select id="mc-sex" class="tool-widget__select" data-field="sex">
          <option value="male" data-i18n="calc.mcMale">{langText(es, 'calc.mcMale')}</option>
          <option value="female" data-i18n="calc.mcFemale">{langText(es, 'calc.mcFemale')}</option>
        </select>
      </div>
      <div class="tool-widget__field">
        <label class="tool-widget__label" for="mc-age" data-i18n="calc.mcAge">{langText(es, 'calc.mcAge')}</label>
        <input id="mc-age" class="tool-widget__input" type="number" step="1" min="10" max="100" value="30" data-field="age" required />
      </div>
      <div class="tool-widget__field">
        <label class="tool-widget__label" for="mc-height" data-i18n="calc.mcHeight">{langText(es, 'calc.mcHeight')}</label>
        <input id="mc-height" class="tool-widget__input" type="number" step="1" min="100" max="250" value="175" data-field="height" required />
      </div>
      <div class="tool-widget__field">
        <label class="tool-widget__label" for="mc-weight" data-i18n="calc.mcWeight">{langText(es, 'calc.mcWeight')}</label>
        <input id="mc-weight" class="tool-widget__input" type="number" step="0.1" min="30" max="300" value="75" data-field="weight" required />
      </div>
      <div class="tool-widget__field" style="grid-column:1/-1">
        <label class="tool-widget__label" for="mc-activity" data-i18n="calc.mcActivity">{langText(es, 'calc.mcActivity')}</label>
        <select id="mc-activity" class="tool-widget__select" data-field="activity">
          {ACTIVITY_LEVELS.map(a => (
            <option value={a.value} data-i18n={`calc.mcAct${a.key.charAt(0).toUpperCase() + a.key.slice(1)}`}>
              {langText(es, `calc.mcAct${a.key.charAt(0).toUpperCase() + a.key.slice(1)}`)}
            </option>
          ))}
        </select>
      </div>
      <div class="tool-widget__field" style="grid-column:1/-1">
        <label class="tool-widget__label" for="mc-goal" data-i18n="calc.mcGoal">{langText(es, 'calc.mcGoal')}</label>
        <select id="mc-goal" class="tool-widget__select" data-field="goal">
          {GOALS.map(g => (
            <option value={g.value} data-adj={g.adj} data-i18n={`calc.mcGoal${g.value.charAt(0).toUpperCase() + g.value.slice(1)}`}>
              {langText(es, `calc.mcGoal${g.value.charAt(0).toUpperCase() + g.value.slice(1)}`)}
            </option>
          ))}
        </select>
      </div>
    </div>

    <div class="tool-widget__field" style="grid-column:1/-1; margin-top:1rem; padding-top:1rem; border-top:1px solid var(--border);">
      <h4 data-i18n="calc.mcMacroSplit">{langText(es, 'calc.mcMacroSplit')}</h4>
      <div class="tool-widget__presets" role="group" style="margin-bottom:0.75rem;">
        {PRESETS.map(p => (
          <button type="button" class="btn btn--ghost btn--sm" data-preset={p.key}
            data-carbs={p.carbs} data-protein={p.protein} data-fat={p.fat}>
            {langText(es, `calc.mcPreset${p.key.charAt(0).toUpperCase() + p.key.slice(1)}`)}
          </button>
        ))}
      </div>
      <div class="tool-widget__grid tool-widget__grid--3">
        <div class="tool-widget__field">
          <label class="tool-widget__label" for="mc-carbs" data-i18n="calc.mcCarbs">{langText(es, 'calc.mcCarbs')}</label>
          <input id="mc-carbs" class="tool-widget__input" type="number" step="1" min="0" max="100" value="40" data-field="carbs" />
        </div>
        <div class="tool-widget__field">
          <label class="tool-widget__label" for="mc-protein" data-i18n="calc.mcProtein">{langText(es, 'calc.mcProtein')}</label>
          <input id="mc-protein" class="tool-widget__input" type="number" step="1" min="0" max="100" value="30" data-field="protein" />
        </div>
        <div class="tool-widget__field">
          <label class="tool-widget__label" for="mc-fat" data-i18n="calc.mcFat">{langText(es, 'calc.mcFat')}</label>
          <input id="mc-fat" class="tool-widget__input" type="number" step="1" min="0" max="100" value="30" data-field="fat" />
        </div>
      </div>
      <p class="tool-widget__note" data-split-sum>
        <span data-lang-region="es">Total: <strong data-val="splitTotal">100</strong>%</span>
        <span data-lang-region="en" hidden>Total: <strong data-val="splitTotal">100</strong>%</span>
      </p>
    </div>

    <div class="tool-widget__actions">
      <button type="submit" class="btn btn--primary" data-i18n="calc.calculate">{langText(es, 'calc.calculate')}</button>
      <button type="button" class="btn btn--ghost" data-reset data-i18n="calc.reset">{langText(es, 'calc.reset')}</button>
    </div>
  </form>

  <div class="tool-widget__result" data-result hidden>
    <p class="tool-widget__error" data-error hidden>
      <span data-lang-region="es" data-i18n="calc.mcError">{langText(es, 'calc.mcError')}</span>
      <span data-lang-region="en" hidden data-i18n="calc.mcError">{langText('en', 'calc.mcError')}</span>
    </p>
    <div class="tool-widget__result-stats tool-widget__result-stats--grid">
      <div class="tool-widget__result-stat">
        <span class="tool-widget__result-stat-label" data-i18n="calc.mcBMR">{langText(es, 'calc.mcBMR')}</span>
        <strong class="tool-widget__result-stat-value" data-val="bmr">—</strong>
      </div>
      <div class="tool-widget__result-stat">
        <span class="tool-widget__result-stat-label" data-i18n="calc.mcTDEE">{langText(es, 'calc.mcTDEE')}</span>
        <strong class="tool-widget__result-stat-value" data-val="tdee">—</strong>
      </div>
      <div class="tool-widget__result-stat">
        <span class="tool-widget__result-stat-label" data-i18n="calc.mcTarget">{langText(es, 'calc.mcTarget')}</span>
        <strong class="tool-widget__result-stat-value" data-val="target">—</strong>
      </div>
    </div>
    <div class="tool-widget__result-stats tool-widget__result-stats--grid" style="margin-top:0.75rem;">
      <div class="tool-widget__result-stat">
        <span class="tool-widget__result-stat-label" data-i18n="calc.mcCarbsG">{langText(es, 'calc.mcCarbsG')}</span>
        <strong class="tool-widget__result-stat-value" data-val="carbsG">—</strong>
      </div>
      <div class="tool-widget__result-stat">
        <span class="tool-widget__result-stat-label" data-i18n="calc.mcProteinG">{langText(es, 'calc.mcProteinG')}</span>
        <strong class="tool-widget__result-stat-value" data-val="proteinG">—</strong>
      </div>
      <div class="tool-widget__result-stat">
        <span class="tool-widget__result-stat-label" data-i18n="calc.mcFatG">{langText(es, 'calc.mcFatG')}</span>
        <strong class="tool-widget__result-stat-value" data-val="fatG">—</strong>
      </div>
    </div>
    <div class="tool-widget__details" data-breakdown hidden>
      <h4 data-i18n="calc.mcBreakdown">{langText(es, 'calc.mcBreakdown')}</h4>
      <table class="tool-widget__table">
        <thead>
          <tr>
            <th data-i18n="calc.mcMacro">{langText(es, 'calc.mcMacro')}</th>
            <th data-i18n="calc.mcPercent">{langText(es, 'calc.mcPercent')}</th>
            <th data-i18n="calc.mcGrams">{langText(es, 'calc.mcGrams')}</th>
            <th data-i18n="calc.mcCalories">{langText(es, 'calc.mcCalories')}</th>
          </tr>
        </thead>
        <tbody data-breakdown-body></tbody>
      </table>
    </div>
  </div>
</div>

<script>
  import { formatSmart } from '../../lib/format.js';
  import { applyLang, currentLang } from '../../i18n.js';

  const root = document.querySelector('[data-widget="macros"]');
  if (root) {
    const form = root.querySelector('[data-calc-form]');
    const result = root.querySelector('[data-result]');
    const error = root.querySelector('[data-error]');
    const breakdownDiv = root.querySelector('[data-breakdown]');
    const breakdownBody = root.querySelector('[data-breakdown-body]');
    const splitTotal = root.querySelector('[data-val="splitTotal"]');
    const fields = {
      sex: root.querySelector('[data-field="sex"]'),
      age: root.querySelector('[data-field="age"]'),
      height: root.querySelector('[data-field="height"]'),
      weight: root.querySelector('[data-field="weight"]'),
      activity: root.querySelector('[data-field="activity"]'),
      goal: root.querySelector('[data-field="goal"]'),
      carbs: root.querySelector('[data-field="carbs"]'),
      protein: root.querySelector('[data-field="protein"]'),
      fat: root.querySelector('[data-field="fat"]'),
    };
    const val = {
      bmr: root.querySelector('[data-val="bmr"]'),
      tdee: root.querySelector('[data-val="tdee"]'),
      target: root.querySelector('[data-val="target"]'),
      carbsG: root.querySelector('[data-val="carbsG"]'),
      proteinG: root.querySelector('[data-val="proteinG"]'),
      fatG: root.querySelector('[data-val="fatG"]'),
    };

    function calcBMR(sex, weight, height, age) {
      if (sex === 'male') {
        return 10 * weight + 6.25 * height - 5 * age + 5;
      } else {
        return 10 * weight + 6.25 * height - 5 * age - 161;
      }
    }

    function compute() {
      const sex = fields.sex.value;
      const age = parseInt(fields.age.value, 10);
      const height = parseFloat(fields.height.value);
      const weight = parseFloat(fields.weight.value);
      const activity = parseFloat(fields.activity.value);
      const goal = fields.goal.value;
      const goalAdj = parseInt(fields.goal.options[fields.goal.selectedIndex].dataset.adj, 10);
      let carbs = parseFloat(fields.carbs.value);
      let protein = parseFloat(fields.protein.value);
      let fat = parseFloat(fields.fat.value);

      const total = carbs + protein + fat;
      splitTotal.textContent = total;

      if (!sex || !age || !height || !weight || !activity || total !== 100) {
        if (total !== 100) {
          error.textContent = 'Los porcentajes deben sumar 100%';
          error.hidden = false;
        } else {
          error.hidden = true;
        }
        result.hidden = true;
        return;
      }

      error.hidden = true;

      const bmr = calcBMR(sex, weight, height, age);
      const tdee = bmr * activity;
      const target = tdee + goalAdj;

      const carbsCal = target * carbs / 100;
      const proteinCal = target * protein / 100;
      const fatCal = target * fat / 100;

      const carbsG = carbsCal / 4;
      const proteinG = proteinCal / 4;
      const fatG = fatCal / 9;

      val.bmr.textContent = formatSmart(bmr) + ' kcal';
      val.tdee.textContent = formatSmart(tdee) + ' kcal';
      val.target.textContent = formatSmart(target) + ' kcal';
      val.carbsG.textContent = formatSmart(carbsG) + ' g';
      val.proteinG.textContent = formatSmart(proteinG) + ' g';
      val.fatG.textContent = formatSmart(fatG) + ' g';

      breakdownBody.innerHTML = `
        <tr><td>Carbohidratos</td><td>${carbs}%</td><td>${formatSmart(carbsG)} g</td><td>${formatSmart(carbsCal)} kcal</td></tr>
        <tr><td>Proteína</td><td>${protein}%</td><td>${formatSmart(proteinG)} g</td><td>${formatSmart(proteinCal)} kcal</td></tr>
        <tr><td>Grasa</td><td>${fat}%</td><td>${formatSmart(fatG)} g</td><td>${formatSmart(fatCal)} kcal</td></tr>
      `;

      breakdownDiv.hidden = false;
      applyLang(currentLang());
      result.hidden = false;
    }

    function updateSplit() {
      const total = parseFloat(fields.carbs.value) + parseFloat(fields.protein.value) + parseFloat(fields.fat.value);
      splitTotal.textContent = total;
    }

    form?.addEventListener('submit', (e) => { e.preventDefault(); compute(); });
    ['sex', 'age', 'height', 'weight', 'activity', 'goal', 'carbs', 'protein', 'fat'].forEach(f => {
      fields[f]?.addEventListener('input', () => { updateSplit(); compute(); });
    });

    root.querySelectorAll('[data-preset]').forEach(btn => {
      btn.addEventListener('click', () => {
        fields.carbs.value = btn.dataset.carbs;
        fields.protein.value = btn.dataset.protein;
        fields.fat.value = btn.dataset.fat;
        updateSplit();
        compute();
      });
    });

    root.querySelector('[data-reset]')?.addEventListener('click', () => {
      fields.sex.value = 'male';
      fields.age.value = '30';
      fields.height.value = '175';
      fields.weight.value = '75';
      fields.activity.value = '1.55';
      fields.goal.value = 'maintain';
      fields.carbs.value = '40';
      fields.protein.value = '30';
      fields.fat.value = '30';
      updateSplit();
      compute();
    });

    updateSplit();
    compute();
  }
</script>