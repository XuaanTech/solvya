---
import { langText } from '../../lib/i18n';
const es = 'es';
---
<div class="tool-widget" data-widget="contrasenas">
  <form class="tool-widget__form" data-calc-form novalidate>
    <div class="tool-widget__grid tool-widget__grid--2">
      <div class="tool-widget__field">
        <label class="tool-widget__label" for="pwd-lon" data-i18n="calc.length">{langText(es, 'calc.length')}</label>
        <div class="tool-widget__range">
          <input id="pwd-lon" class="tool-widget__range-input" type="range" min="6" max="64" value="16" data-field="long" />
          <output class="tool-widget__range-value" data-val="longOut">16</output>
        </div>
      </div>
      <div class="tool-widget__field">
        <span class="tool-widget__label" data-i18n="calc.options">{langText(es, 'calc.options')}</span>
        <div class="tool-widget__toggles">
          <label class="tool-widget__check">
            <input type="checkbox" data-opt="upper" checked />
            <span data-i18n="calc.uppercase">{langText(es, 'calc.uppercase')}</span>
          </label>
          <label class="tool-widget__check">
            <input type="checkbox" data-opt="lower" checked />
            <span data-i18n="calc.lowercase">{langText(es, 'calc.lowercase')}</span>
          </label>
          <label class="tool-widget__check">
            <input type="checkbox" data-opt="nums" checked />
            <span data-i18n="calc.numbers">{langText(es, 'calc.numbers')}</span>
          </label>
          <label class="tool-widget__check">
            <input type="checkbox" data-opt="symbols" checked />
            <span data-i18n="calc.symbols">{langText(es, 'calc.symbols')}</span>
          </label>
        </div>
      </div>
    </div>
    <div class="tool-widget__actions">
      <button type="submit" class="btn btn--primary" data-i18n="calc.generate">{langText(es, 'calc.generate')}</button>
      <button type="button" class="btn btn--ghost" data-reset data-i18n="calc.reset">{langText(es, 'calc.reset')}</button>
    </div>
  </form>

  <div class="tool-widget__result" data-result>
    <p class="tool-widget__error" data-error hidden>
      <span data-lang-region="es">Selecciona al menos un tipo de carácter.</span>
      <span data-lang-region="en" hidden>Select at least one character type.</span>
    </p>
    <code class="tool-widget__password" data-val="password">—</code>
    <div class="tool-widget__coderow">
      <span class="tool-widget__coderow-label" data-i18n="calc.passwordStrength">{langText(es, 'calc.passwordStrength')}</span>
      <strong class="tool-widget__strength">
        <span data-val="str-es" data-lang-region="es"></span>
        <span data-val="str-en" data-lang-region="en" hidden></span>
      </strong>
      <span style="flex:1"></span>
      <button type="button" class="btn btn--ghost btn--sm" data-copy data-i18n="calc.copy">{langText(es, 'calc.copy')}</button>
      <span class="tool-widget__copied" data-copied hidden data-i18n="calc.copied">{langText(es, 'calc.copied')}</span>
    </div>
  </div>
</div>

<script>
  import { applyLang, textOf, currentLang } from '../../i18n.js';

  const root = document.querySelector('[data-widget="contrasenas"]');
  if (root) {
    const form = root.querySelector('[data-calc-form]');
    const result = root.querySelector('[data-result]');
    const error = root.querySelector('[data-error]');
    const longInput = root.querySelector('[data-field="long"]');
    const longOut = root.querySelector('[data-val="longOut"]');
    const passwordEl = root.querySelector('[data-val="password"]');
    const opts = [...root.querySelectorAll('[data-opt]')];
    const val = {
      strEs: root.querySelector('[data-val="str-es"]'),
      strEn: root.querySelector('[data-val="str-en"]'),
    };

    const CHARSETS = {
      upper: 'ABCDEFGHIJKLMNOPQRSTUVWXYZ',
      lower: 'abcdefghijklmnopqrstuvwxyz',
      nums: '0123456789',
      symbols: '!@#$%^&*()-_=+[]{};:,.?',
    };

    function strengthKey(pwd, setCount) {
      let score = setCount - 1;
      const len = pwd.length;
      if (len >= 24) score += 4; else if (len >= 16) score += 3; else if (len >= 12) score += 2; else if (len >= 8) score += 1;
      if (score >= 7) return 'veryStrong';
      if (score >= 5) return 'strong';
      if (score >= 3) return 'medium';
      return 'weak';
    }

    function generate() {
      const len = parseInt(longInput.value, 10) || 16;
      const selected = opts.filter((o) => o.checked);
      if (selected.length === 0) { error.hidden = false; return; }
      error.hidden = true;

      const sets = selected.map((o) => CHARSETS[o.dataset.opt]);
      const pool = sets.join('');
      const buf = new Uint32Array(len);
      crypto.getRandomValues(buf);

      const chars = [];
      sets.forEach((cat, i) => chars.push(cat[buf[i] % cat.length]));
      for (let i = sets.length; i < len; i++) chars.push(pool[buf[i] % pool.length]);
      for (let i = chars.length - 1; i > 0; i--) {
        const j = buf[i] % (i + 1);
        [chars[i], chars[j]] = [chars[j], chars[i]];
      }

      const pwd = chars.join('');
      passwordEl.textContent = pwd;
      const key = strengthKey(pwd, sets.length);
      val.strEs.textContent = textOf('es', 'calc.strength.' + key);
      val.strEn.textContent = textOf('en', 'calc.strength.' + key);
      applyLang(currentLang());
    }

    function copyPwd() {
      const text = passwordEl.textContent;
      if (!text || text === '—') return Promise.resolve();
      const cb = navigator.clipboard && navigator.clipboard.writeText
        ? navigator.clipboard.writeText(text).catch(() => fallbackCopy(text))
        : fallbackCopy(text);
      return cb.then(() => {
        const fb = root.querySelector('[data-copied]');
        if (fb) { fb.hidden = false; setTimeout(() => { fb.hidden = true; }, 1600); }
      });
    }
    function fallbackCopy(text) {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      try { document.execCommand('copy'); } catch { /* noop */ }
      ta.remove();
      return Promise.resolve();
    }

    longInput.addEventListener('input', () => { longOut.value = longInput.value; generate(); });
    opts.forEach((o) => o.addEventListener('change', generate));
    form?.addEventListener('submit', (e) => { e.preventDefault(); generate(); });
    root.querySelector('[data-copy]')?.addEventListener('click', copyPwd);
    root.querySelector('[data-reset]')?.addEventListener('click', () => {
      longInput.value = '16'; longOut.value = '16';
      opts.forEach((o) => { o.checked = true; });
      generate();
    });
    generate();
  }
</script>