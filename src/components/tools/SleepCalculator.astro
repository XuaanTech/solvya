---
import { langText } from '../../lib/i18n';
const es = 'es';
---
<div class="tool-widget" data-widget="sueno">
  <form class="tool-widget__form" data-calc-form novalidate>
    <div class="tool-widget__grid tool-widget__grid--2">
      <div class="tool-widget__field">
        <label class="tool-widget__label" for="sueno-hora" data-i18n="calc.suenoWake">{langText(es, 'calc.suenoWake')}</label>
        <input id="sueno-hora" class="tool-widget__input" type="time" value="07:00" data-field="hora" />
      </div>
      <div class="tool-widget__field">
        <label class="tool-widget__label" for="sueno-edad" data-i18n="calc.suenoAge">{langText(es, 'calc.suenoAge')}</label>
        <input id="sueno-edad" class="tool-widget__input" type="number" min="1" max="120" inputmode="numeric" value="30" data-field="edad" />
      </div>
    </div>
    <div class="tool-widget__actions">
      <button type="submit" class="btn btn--primary" data-i18n="calc.calculate">{langText(es, 'calc.calculate')}</button>
      <button type="button" class="btn btn--ghost" data-reset data-i18n="calc.suenoWake">{langText(es, 'calc.suenoWake')}: 07:00</button>
    </div>
  </form>

  <div class="tool-widget__result" data-result hidden>
    <p class="tool-widget__error" data-error hidden>
      <span data-lang-region="es" data-i18n="calc.suenoInvalid">{langText(es, 'calc.suenoInvalid')}</span>
      <span data-lang-region="en" hidden data-i18n="calc.suenoInvalid">{langText('en', 'calc.suenoInvalid')}</span>
    </p>
    <p class="tool-widget__label-static">
      <span data-lang-region="es" data-i18n="calc.suenoBedAt">{langText(es, 'calc.suenoBedAt')}</span>
      <span data-lang-region="en" hidden data-i18n="calc.suenoBedAt">{langText('en', 'calc.suenoBedAt')}</span>
    </p>
    <div class="sueno-options" data-sueno-options></div>
    <p class="tool-widget__note">
      <span data-lang-region="es" data-i18n="calc.suenoNote">{langText(es, 'calc.suenoNote')}</span>
      <span data-lang-region="en" hidden data-i18n="calc.suenoNote">{langText('en', 'calc.suenoNote')}</span>
    </p>
  </div>
</div>

<script>
  import { applyLang, currentLang } from '../../i18n.js';

  const root = document.querySelector('[data-widget="sueno"]');
  if (root) {
    const form = root.querySelector('[data-calc-form]');
    const result = root.querySelector('[data-result]');
    const error = root.querySelector('[data-error]');
    const optionsEl = root.querySelector('[data-sueno-options]');
    const hora = root.querySelector('[data-field="hora"]');
    const edad = root.querySelector('[data-field="edad"]');

    const D = {
      es: {
        cycles: (n) => n + (n === 1 ? ' ciclo completo' : ' ciclos completos'),
        hours: 'horas de sueño',
        wake: 'para despertar a las',
        rec: 'recomendada para tu edad',
      },
      en: {
        cycles: (n) => n + (n === 1 ? ' full cycle' : ' full cycles'),
        hours: 'hours of sleep',
        wake: 'to wake up at',
        rec: 'recommended for your age',
      },
    };

    function pad(n) { return String(n).padStart(2, '0'); }

    function toMin(s) {
      const m = /^(\d{2}):(\d{2})$/.exec(s || '');
      return m ? Number(m[1]) * 60 + Number(m[2]) : null;
    }

    function fmtMin(min) {
      const norm = ((min % 1440) + 1440) % 1440;
      return pad(Math.floor(norm / 60)) + ':' + pad(norm % 60);
    }

    function recommendedCycles(age) {
      const a = Number(age);
      if (!Number.isFinite(a) || a <= 0) return 5;
      if (a < 12) return 7;
      if (a < 18) return 6;
      if (a < 65) return 5;
      return 4;
    }

    function render(dict, wakeMin, cycles, recCycles) {
      optionsEl.innerHTML = '';
      const rows = [4, 5, 6, 7, 8];
      for (const c of rows) {
        const bed = wakeMin - 15 - c * 90; // 15 min para conciliar el sueño
        const hMin = c * 90;
        const div = document.createElement('div');
        div.className = 'sueno-option' + (c === recCycles ? ' is-active' : '');
        div.innerHTML =
          '<strong class="sueno-option__time">' + fmtMin(bed) + '</strong>' +
          '<span class="sueno-option__meta">' +
            D[dict].cycles(c) + ' · ' + Math.floor(hMin / 60) + ' h ' + (hMin % 60) + ' min ' + D[dict].hours +
            ' · ' + D[dict].wake + ' ' + fmtMin(wakeMin) +
          '</span>' +
          (c === recCycles
            ? '<span class="sueno-option__badge">' + D[dict].rec + '</span>'
            : '');
        optionsEl.appendChild(div);
      }
    }

    function compute() {
      const lang = currentLang();
      const wakeMin = toMin(hora.value);
      if (wakeMin === null) {
        error.hidden = false;
        result.hidden = true;
        return;
      }
      error.hidden = true;
      const dict = lang === 'en' ? 'en' : 'es';
      render(dict, wakeMin, 0, recommendedCycles(edad.value));
      applyLang(lang);
      result.hidden = false;
    }

    form?.addEventListener('submit', (e) => { e.preventDefault(); compute(); });
    hora.addEventListener('change', compute);
    edad.addEventListener('input', compute);
    root.querySelector('[data-reset]')?.addEventListener('click', () => {
      hora.value = '07:00';
      edad.value = '30';
      compute();
    });
    compute();
  }
</script>

<style>
  .tool-widget__label-static { font-weight: 600; margin: 0 0 0.5rem; }
  .sueno-options { display: grid; gap: 0.5rem; margin-bottom: 0.75rem; }
  .sueno-option {
    display: flex; align-items: center; gap: 0.75rem;
    padding: 0.6rem 0.85rem; border: 1px solid var(--border); border-radius: var(--radius);
  }
  .sueno-option.is-active { border-color: var(--primary); background: color-mix(in srgb, var(--primary) 6%, transparent); }
  .sueno-option__time { font-size: 1.15rem; font-weight: 700; font-variant-numeric: tabular-nums; min-width: 3.4rem; }
  .sueno-option__meta { color: var(--text-muted); font-size: 0.9rem; flex: 1; }
  .sueno-option__badge {
    font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.04em;
    background: var(--primary); color: #fff; padding: 0.2rem 0.5rem; border-radius: 999px; white-space: nowrap;
  }
</style>