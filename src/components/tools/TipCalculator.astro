---
import { langText } from '../../lib/i18n';
const es = 'es';
---
<div class="tool-widget" data-widget="propina">
  <form class="tool-widget__form" data-calc-form novalidate>
    <div class="tool-widget__grid tool-widget__grid--2">
      <div class="tool-widget__field">
        <label class="tool-widget__label" for="tip-cuenta" data-i18n="calc.tipBill">{langText(es, 'calc.tipBill')}</label>
        <input id="tip-cuenta" class="tool-widget__input" type="text" inputmode="decimal" autocomplete="off" value="45" data-field="cuenta" />
      </div>
      <div class="tool-widget__field">
        <label class="tool-widget__label" for="tip-pct" data-i18n="calc.tipPercent">{langText(es, 'calc.tipPercent')}</label>
        <input id="tip-pct" class="tool-widget__input" type="number" min="0" inputmode="numeric" value="10" data-field="propina" />
      </div>
      <div class="tool-widget__field">
        <label class="tool-widget__label" for="tip-people" data-i18n="calc.tipPeople">{langText(es, 'calc.tipPeople')}</label>
        <input id="tip-people" class="tool-widget__input" type="number" min="1" inputmode="numeric" value="1" data-field="personas" />
      </div>
    </div>
    <div class="tool-widget__actions">
      <button type="submit" class="btn btn--primary" data-i18n="calc.calculate">{langText(es, 'calc.calculate')}</button>
      <button type="button" class="btn btn--ghost" data-reset data-i18n="calc.reset">{langText(es, 'calc.reset')}</button>
    </div>
  </form>

  <div class="tool-widget__result" data-result hidden>
    <p class="tool-widget__error" data-error hidden>
      <span data-lang-region="es" data-i18n="calc.tipInvalid">{langText(es, 'calc.tipInvalid')}</span>
      <span data-lang-region="en" hidden data-i18n="calc.tipInvalid">{langText('en', 'calc.tipInvalid')}</span>
    </p>
    <div class="result-stats">
      <div class="result-stat">
        <span class="result-stat__label" data-i18n="calc.tipAmount">{langText(es, 'calc.tipAmount')}</span>
        <strong class="result-stat__value" data-val="propina">—</strong>
      </div>
      <div class="result-stat">
        <span class="result-stat__label" data-i18n="calc.tipTotal">{langText(es, 'calc.tipTotal')}</span>
        <strong class="result-stat__value" data-val="total">—</strong>
      </div>
      <div class="result-stat">
        <span class="result-stat__label" data-i18n="calc.tipEach">{langText(es, 'calc.tipEach')}</span>
        <strong class="result-stat__value" data-val="cada">—</strong>
      </div>
    </div>
  </div>
</div>

<script>
  import { parseDecimal, formatEur } from '../../lib/format.js';
  import { applyLang, currentLang } from '../../i18n.js';

  const root = document.querySelector('[data-widget="propina"]');
  if (root) {
    const form = root.querySelector('[data-calc-form]');
    const result = root.querySelector('[data-result]');
    const error = root.querySelector('[data-error]');
    const fields = {
      cuenta: root.querySelector('[data-field="cuenta"]'),
      propina: root.querySelector('[data-field="propina"]'),
      personas: root.querySelector('[data-field="personas"]'),
    };
    const val = {
      propina: root.querySelector('[data-val="propina"]'),
      total: root.querySelector('[data-val="total"]'),
      cada: root.querySelector('[data-val="cada"]'),
    };

    function compute() {
      const bill = parseDecimal(fields.cuenta.value);
      const pct = parseDecimal(fields.propina.value);
      const people = Math.max(1, Math.floor(parseDecimal(fields.personas.value)));
      if (bill <= 0) { error.hidden = false; result.hidden = true; return; }
      error.hidden = true;
      const tip = bill * (pct / 100);
      const total = bill + tip;
      val.propina.textContent = formatEur(tip);
      val.total.textContent = formatEur(total);
      val.cada.textContent = formatEur(total / people);
      applyLang(currentLang());
      result.hidden = false;
    }

    form?.addEventListener('submit', (e) => { e.preventDefault(); compute(); });
    for (const f of Object.values(fields)) f.addEventListener('input', compute);
    root.querySelector('[data-reset]')?.addEventListener('click', () => {
      fields.cuenta.value = '45';
      fields.propina.value = '10';
      fields.personas.value = '1';
      compute();
    });
    compute();
  }
</script>