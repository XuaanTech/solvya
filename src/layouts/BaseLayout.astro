---
import Logo from '../components/Logo.astro';
import SearchBar from '../components/SearchBar.astro';
import { SITE } from '../data/site';
import { langText } from '../lib/i18n';
import { organizationSchema } from '../lib/seo';
import { langBase, pick } from '../lib/utils';
import categories from '../data/categories.json';
import tools from '../data/tools.json';

interface Props {
  title: string;
  description: string;
  lang?: string;
  canonicalURL?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  articleAuthor?: string;
  articleSection?: string;
  /** When false (ES-only page), no `hreflang=en` is emitted and the EN toggle is hidden. */
  hasEn?: boolean;
}

const {
  title,
  description,
  lang: pageLang = 'es',
  canonicalURL = new URL(Astro.url.pathname, SITE.url).href,
  ogImage = `${SITE.url}/og-default.png`,
  ogType = 'website',
  noindex = false,
  articlePublishedTime,
  articleModifiedTime,
  articleAuthor,
  articleSection,
  hasEn = true,
} = Astro.props;

const fullTitle = title === SITE.name ? title : `${title} | ${SITE.name}`;
const currentPath = Astro.url.pathname;
const base = langBase(pageLang);
const ogLocale = pageLang === 'en' ? 'en_US' : 'es_ES';

// Alternate language URLs for hreflang
const showEnAlt = pageLang === 'en' || hasEn;
const alternatePath = pageLang === 'en'
  ? currentPath.replace(/^\/en/, '') || '/'
  : `/en${currentPath}`;
const esURL = pageLang === 'es' ? canonicalURL : `${SITE.url}${currentPath.replace(/^\/en/, '') || '/'}`;
const enURL = pageLang === 'en' ? canonicalURL : `${SITE.url}/en${currentPath}`;
const xDefaultURL = `${SITE.url}${currentPath.replace(/^\/en/, '') || '/'}`;

const navLinks = [
  { href: `${base}/`, key: 'nav.home' },
  ...categories.map((c) => ({ href: `${base}/${c.slug}/`, key: `categories.${c.slug}.name` })),
  { href: `${base}/about/`, key: 'nav.about' },
];

// Language toggle: link to the same page in the other language
const langToggleHref = pageLang === 'en'
  ? currentPath.replace(/^\/en/, '') || '/'
  : `/en${currentPath}`;

const orgSchema = organizationSchema(pageLang);
---

<!DOCTYPE html>
<html lang={pageLang} data-lang={pageLang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="robots" content={`${noindex ? 'noindex, nofollow' : 'index, follow'}, max-image-preview:large, max-snippet:-1, max-video-preview:-1`} />
  <link rel="canonical" href={canonicalURL} />
  <link rel="alternate" hreflang="es" href={esURL} />
  {showEnAlt && <link rel="alternate" hreflang="en" href={enURL} />}
  <link rel="alternate" hreflang="x-default" href={xDefaultURL} />
  <meta name="theme-color" content="#063062" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#0f172a" media="(prefers-color-scheme: dark)" />

  <!-- Open Graph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content={ogLocale} />
  {ogType === 'article' && articlePublishedTime && (
    <meta property="article:published_time" content={articlePublishedTime} />
  )}
  {ogType === 'article' && articleModifiedTime && (
    <meta property="article:modified_time" content={articleModifiedTime} />
  )}
  {ogType === 'article' && articleAuthor && (
    <meta property="article:author" content={articleAuthor} />
  )}
  {ogType === 'article' && articleSection && (
    <meta property="article:section" content={articleSection} />
  )}

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <title>{fullTitle}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="alternate" type="application/rss+xml" title={`${SITE.name} RSS`} href={`${SITE.url}/rss.xml`} />

  <!-- Rendering-friendly CSS -->
  <style is:global>
    @import '../styles/global.css';
    @import '../styles/components.css';
  </style>

  <!-- Site-wide Organization schema -->
  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />

  <!-- Google AdSense -->
  <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${SITE.adsClient}`} crossorigin="anonymous"></script>
</head>
<body>
  <header class="header">
    <div class="container header__inner">
      <a href={`${base}/`} class="header__logo" aria-label={`${SITE.shortName} — ${langText(pageLang, 'nav.home')}`}>
        <Logo className="header__logo-icon" size={44} />
        <span>{SITE.shortName}</span>
      </a>

      <div class="header__actions">
        <div class="lang-toggle" role="group" data-i18n-aria="ui.langLabel" aria-label={langText(pageLang, 'ui.langLabel')}>
          <a href={pageLang === 'es' ? currentPath : langToggleHref} class={`lang-toggle__btn ${pageLang === 'es' ? 'lang-toggle__btn--active' : ''}`} aria-pressed={pageLang === 'es'}>
            🇪🇸 <span>ES</span>
          </a>
          {showEnAlt && (
            <a href={pageLang === 'en' ? currentPath : langToggleHref} class={`lang-toggle__btn ${pageLang === 'en' ? 'lang-toggle__btn--active' : ''}`} aria-pressed={pageLang === 'en'}>
              🇬🇧 <span>EN</span>
            </a>
          )}
        </div>

        <button class="header__menu-btn" data-i18n-aria="ui.menuToggle" aria-label={langText(pageLang, 'ui.menuToggle')} aria-expanded="false" aria-controls="main-nav" id="menu-toggle">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M3 12h18M3 6h18M3 18h18" />
          </svg>
        </button>
      </div>

      <nav class="header__nav" id="main-nav" data-i18n-aria="ui.navLabel" aria-label={langText(pageLang, 'ui.navLabel')}>
        {navLinks.map((link) => {
          const isActive = link.href === `${base}/`
            ? currentPath === `${base}/` || (base === '' && currentPath === '/')
            : currentPath.startsWith(link.href);
          return (
            <a
              href={link.href}
              data-astro-prefetch="hover"
              class={`header__nav-link ${isActive ? 'header__nav-link--active' : ''}`}
              aria-current={isActive ? 'page' : undefined}
              data-i18n={link.key}
            >
              {langText(pageLang, link.key)}
            </a>
          );
        })}
      </nav>
    </div>
    <div class="container header__search">
      <SearchBar lang={pageLang} />
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="footer">
    <div class="container">
      <div class="footer__grid">
        <div class="footer__brand">
          <div class="footer__brand-name">
            <Logo className="header__logo-icon" size={28} />
            <span>{SITE.name}</span>
          </div>
          <p class="footer__brand-desc" data-i18n="footer.desc">{langText(pageLang, 'footer.desc')}</p>
        </div>

        <div>
          <h3 class="footer__heading" data-i18n="footer.categories">{langText(pageLang, 'footer.categories')}</h3>
          <div class="footer__links">
            {categories.map((c) => (
              <a href={`${base}/${c.slug}/`} class="footer__link" data-i18n={`categories.${c.slug}.name`}>
                {langText(pageLang, `categories.${c.slug}.name`)}
              </a>
            ))}
          </div>
        </div>

        <div>
          <h3 class="footer__heading" data-i18n="footer.tools">{langText(pageLang, 'footer.tools')}</h3>
          <div class="footer__links">
            {tools.map((t) => (
              <a href={`${base}/herramienta/${t.slug}/`} class="footer__link">
                {pick(t.name, pageLang)}
              </a>
            ))}
          </div>
        </div>

        <div>
          <h3 class="footer__heading" data-i18n="footer.legal">{langText(pageLang, 'footer.legal')}</h3>
          <div class="footer__links">
            <a href={`${base}/about/`} class="footer__link" data-i18n="nav.about">{langText(pageLang, 'nav.about')}</a>
            <a href={`${base}/contact/`} class="footer__link" data-i18n="contact.title">{langText(pageLang, 'contact.title')}</a>
            <a href={`${base}/privacy-policy/`} class="footer__link" data-i18n="privacy.title">{langText(pageLang, 'privacy.title')}</a>
            <a href={`${base}/disclaimer/`} class="footer__link" data-i18n="disclaimer.title">{langText(pageLang, 'disclaimer.title')}</a>
            <a href={`${base}/terms/`} class="footer__link" data-i18n="terms.title">{langText(pageLang, 'terms.title')}</a>
            <a href="/rss.xml" class="footer__link">RSS</a>
            <a href={`mailto:${SITE.email}`} class="footer__link">{SITE.email}</a>
          </div>
        </div>
      </div>
      <div class="footer__bottom">
        &copy; {new Date().getFullYear()} {SITE.name}. <span data-i18n="footer.rights">{langText(pageLang, 'footer.rights')}</span>
      </div>
    </div>
  </footer>

  <script is:inline>
    const toggle = document.getElementById('menu-toggle');
    const nav = document.getElementById('main-nav');
    toggle?.addEventListener('click', () => {
      const isOpen = nav?.classList.toggle('header__nav--open') ?? false;
      toggle.setAttribute('aria-expanded', String(isOpen));
    });
  </script>

  <script>
    // Apply the server-rendered page language to data-i18n / data-lang-region elements
    // (widget labels, FAQ regions) without re-detecting language or writing localStorage.
    import { applyLang, currentLang } from '../i18n.js';
    applyLang(currentLang());
  </script>
</body>
</html>